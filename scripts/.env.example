# Copy to scripts/.env (gitignored) and fill in. Never commit real keys.
# Server-side only: never expose these through a VITE_* variable in the frontend.

# Resend API key with "Sending access": https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown to students. Must use a domain verified in Resend.
# For testing without a verified domain, use "My Flock <onboarding@resend.dev>";
# Resend then only delivers to the email address on your Resend account.
MATCH_EMAIL_FROM=My Flock <onboarding@resend.dev>

# Optional: where student replies go.
MATCH_EMAIL_REPLY_TO=
